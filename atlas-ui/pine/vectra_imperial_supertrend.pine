//@version=6
indicator("Vectra Imperial SuperTrend [ZEMA-KAMA + RevRSI v6]", overlay=true, max_labels_count=500)

// =============================================================================
// 1. PARÂMETROS DO SISTEMA UNIFICADO
// =============================================================================
grp_st   = "1. Motor SuperTrend (ZEMA + KAMA)"
len_zema = input.int(14, "Período ZEMA (Zero-Lag)", group=grp_st)
len_kama = input.int(21, "Período KAMA (Freio Adaptativo)", group=grp_st)
atr_mult = input.float(2.2, "Multiplicador de Banda ATR", step=0.1, group=grp_st)

grp_rev  = "2. Engenharia Reversa RSI no Preço"
len_rsi  = input.int(14, "Período RSI Base", group=grp_rev)
ob_level = input.float(70.0, "Alvo Preço RSI Sobrecompra", group=grp_rev)
os_level = input.float(30.0, "Alvo Preço RSI Sobrevenda", group=grp_rev)

grp_ang  = "3. Previsibilidade Angular & CVD"
ang_thresh = input.float(35.0, "Ângulo Mínimo de Ignição (Graus)", group=grp_ang)
cvd_mult   = input.float(1.5, "Sensibilidade Absorção CVD", group=grp_ang)

// =============================================================================
// 2. CÁLCULO ZEMA (ZERO-LAG) + KAMA (ADAPTATIVA)
// =============================================================================
// Zero-Lag EMA (ZEMA)
int lag = math.floor((len_zema - 1) / 2)
float zema_src = close + (close - nz(close[lag]))
float zema = ta.ema(zema_src, len_zema)

// Kaufman Adaptive Moving Average (KAMA)
float change = math.abs(close - close[len_kama])
float volatility = math.sum(math.abs(close - close[1]), len_kama)
float er = volatility != 0 ? change / volatility : 0.0
float fast_sc = 2.0 / (2.0 + 1.0)
float slow_sc = 2.0 / (30.0 + 1.0)
float sc = math.pow(er * (fast_sc - slow_sc) + slow_sc, 2)
var float kama = na
kama := na(kama[1]) ? close : kama[1] + sc * (close - kama[1])

// Núcleo Híbrido (Equilíbrio entre velocidade ZEMA e freio KAMA)
float core_ma = (zema * 0.6) + (kama * 0.4)

// =============================================================================
// 3. SUPERTREND INSTITUCIONAL COM TRAILING DINÂMICO
// =============================================================================
float atr = ta.atr(14)
float upper_band = core_ma + (atr_mult * atr)
float lower_band = core_ma - (atr_mult * atr)

var float st_line = na
var int st_dir = 1 // 1 = BULL, -1 = BEAR

float prev_upper = nz(upper_band[1], upper_band)
float prev_lower = nz(lower_band[1], lower_band)

upper_band := (upper_band < prev_upper or close[1] > prev_upper) ? upper_band : prev_upper
lower_band := (lower_band > prev_lower or close[1] < prev_lower) ? lower_band : prev_lower

if na(st_line[1])
    st_dir := 1
else if st_line[1] == prev_upper
    st_dir := close > upper_band ? 1 : -1
else
    st_dir := close < lower_band ? -1 : 1

st_line := st_dir == 1 ? lower_band : upper_band

// =============================================================================
// 4. PREVISIBILIDADE POR ÂNGULO (VETOR DE VELOCIDADE)
// =============================================================================
// Normaliza a inclinação da ZEMA pelo ATR para obter o ângulo real em graus
float slope = (zema - zema[3]) / (3 * (atr == 0 ? 1 : atr))
float angle_deg = math.atan(slope) * (180.0 / math.pi)
bool strong_angle = math.abs(angle_deg) >= ang_thresh

// =============================================================================
// 5. ENGENHARIA REVERSA DO RSI (PREÇO PROJETADO DE EXAUSTÃO)
// =============================================================================
f_reverse_rsi(float target_rsi, int length) =>
    float up = math.max(close - close[1], 0)
    float dn = math.max(close[1] - close, 0)
    float avg_up = ta.rma(up, length)
    float avg_dn = ta.rma(dn, length)
    float x = (length - 1) * (avg_dn * target_rsi / (100.0 - target_rsi) - avg_up)
    x >= 0 ? close + x : close + x * (100.0 - target_rsi) / target_rsi

float price_rsi_ob = f_reverse_rsi(ob_level, len_rsi) // Preço onde RSI bate 70
float price_rsi_os = f_reverse_rsi(os_level, len_rsi) // Preço onde RSI bate 30
float price_rsi_50 = f_reverse_rsi(50.0, len_rsi)     // Preço de equilíbrio (RSI 50)

// =============================================================================
// 6. MTF CONFLUENCE + CVD VOLUME INSTITUCIONAL
// =============================================================================
float mtf_1h = request.security(syminfo.tickerid, "60", ta.ema(close, 8) > ta.ema(close, 21) ? 1.0 : -1.0, barmerge.gaps_off, barmerge.lookahead_off)
float mtf_1d = request.security(syminfo.tickerid, "D",  ta.ema(close, 8) > ta.ema(close, 21) ? 1.0 : -1.0, barmerge.gaps_off, barmerge.lookahead_off)

// CVD Delta com fallback de volatilidade (para pares Deriv sem volume real)
float eff_vol   = volume > 0 ? volume : ta.tr
float vol_delta = ((close - low) - (high - close)) / (high - low == 0 ? 1 : high - low) * eff_vol
float vol_mean  = ta.sma(vol_delta, 20)
float vol_std   = ta.stdev(vol_delta, 20)

float rsi_now = ta.rsi(close, len_rsi)
bool cvd_abs_top = (vol_delta < vol_mean - cvd_mult * vol_std) and (rsi_now >= ob_level - 3)
bool cvd_abs_bot = (vol_delta > vol_mean + cvd_mult * vol_std) and (rsi_now <= os_level + 3)

// =============================================================================
// 7. PLOTAGEM VISUAL NO PREÇO
// =============================================================================
// Linha Principal SuperTrend (Muda brilho conforme força do ângulo)
color st_col = st_dir == 1 ? (strong_angle ? #00E676 : color.new(#00E676, 45)) : (strong_angle ? #FF1744 : color.new(#FF1744, 45))
p_st = plot(st_line, "SuperTrend ZEMA-KAMA", color=st_col, linewidth=3)
p_cl = plot(close, display=display.none)

// Preenchimento de Canal de Proteção
fill(p_st, p_cl, color=st_dir == 1 ? color.new(#00E676, 92) : color.new(#FF1744, 92), title="Zona de Trailing")

// Bandas de Engenharia Reversa do RSI (Alvos de TP e Reversão no Preço)
plot(price_rsi_ob, "RevRSI 70 (Teto Exaustão)", color=color.new(#FF007F, 40), style=plot.style_line, linewidth=1)
plot(price_rsi_50, "RevRSI 50 (Equilíbrio)",    color=color.new(#8B949E, 60), style=plot.style_dotted, linewidth=1)
plot(price_rsi_os, "RevRSI 30 (Fundo Absorção)", color=color.new(#00E5FF, 40), style=plot.style_line, linewidth=1)

// Sinais de Virada do SuperTrend
bool flip_bull = st_dir == 1 and st_dir[1] == -1
bool flip_bear = st_dir == -1 and st_dir[1] == 1

plotshape(flip_bull, title="Virada BULL", style=shape.labelup,   location=location.belowbar, color=#00E676, text="BUY",  textcolor=#000000, size=size.tiny)
plotshape(flip_bear, title="Virada BEAR", style=shape.labeldown, location=location.abovebar, color=#FF1744, text="SELL", textcolor=#FFFFFF, size=size.tiny)

// Halos de Absorção Institucional (CVD)
plotshape(cvd_abs_top, title="Absorção CVD Topo",  style=shape.circle, location=location.abovebar, color=#FF007F, size=size.small)
plotshape(cvd_abs_bot, title="Absorção CVD Fundo", style=shape.circle, location=location.belowbar, color=#00E5FF, size=size.small)

// =============================================================================
// 8. PAINEL HUD DE PREVISIBILIDADE E EXECUÇÃO
// =============================================================================
var table hud = table.new(position.top_right, 2, 5, bgcolor=#0D1117, border_color=#21262D, border_width=1)

if barstate.islast
    table.cell(hud, 0, 0, "VECTRA SUPERTREND", bgcolor=#161B22, text_color=#00E5FF, text_size=size.tiny)
    table.cell(hud, 1, 0, st_dir == 1 ? "BULLISH" : "BEARISH", bgcolor=#161B22, text_color=(st_dir == 1 ? #00E676 : #FF1744), text_size=size.tiny)

    table.cell(hud, 0, 1, "ÂNGULO VETOR", bgcolor=#0D1117, text_color=#8B949E, text_size=size.tiny)
    table.cell(hud, 1, 1, str.tostring(angle_deg, "#.1") + "° " + (strong_angle ? "(FORTE)" : "(FRACO)"), bgcolor=#0D1117, text_color=(strong_angle ? #FFEB3B : #8B949E), text_size=size.tiny)

    table.cell(hud, 0, 2, "ALVO REV-RSI 70", bgcolor=#0D1117, text_color=#8B949E, text_size=size.tiny)
    table.cell(hud, 1, 2, str.tostring(price_rsi_ob, format.mintick), bgcolor=#0D1117, text_color=#FF007F, text_size=size.tiny)

    table.cell(hud, 0, 3, "ALVO REV-RSI 30", bgcolor=#0D1117, text_color=#8B949E, text_size=size.tiny)
    table.cell(hud, 1, 3, str.tostring(price_rsi_os, format.mintick), bgcolor=#0D1117, text_color=#00E5FF, text_size=size.tiny)

    string mtf_status = (mtf_1h > 0 and mtf_1d > 0) ? "ALINHADO BULL" : (mtf_1h < 0 and mtf_1d < 0) ? "ALINHADO BEAR" : "DIVERGENTE (REPIQUE)"
    color mtf_col     = (mtf_1h > 0 and mtf_1d > 0) ? #00E676 : (mtf_1h < 0 and mtf_1d < 0) ? #FF1744 : #FF9100
    table.cell(hud, 0, 4, "FLUXO MACRO 1H/1D", bgcolor=#161B22, text_color=#8B949E, text_size=size.tiny)
    table.cell(hud, 1, 4, mtf_status, bgcolor=#161B22, text_color=mtf_col, text_size=size.tiny)
