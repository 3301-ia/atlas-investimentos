//@version=5
indicator("Vectra Dynamic (Pure Stepped Trailing & Targets) - Suavizado MTF", overlay=true, max_labels_count=500, max_lines_count=500)

// =============================================================================
// 1. PARÂMETROS
// =============================================================================
grp_engine  = "Linguagem de Regime & Filtro de Suavização"
fast_len    = input.int(10, "Período Base ZLEMA", minval=1, group=grp_engine)
kama_len    = input.int(34, "Período Lento KAMA (Filtro Macro)", minval=1, group=grp_engine)
hist_mult   = input.float(0.40, "Histerese ATR (Anti-Ruído Micro-Tempos)", minval=0.1, step=0.05, group=grp_engine)
len_atr     = input.int(14, "Período ATR (Volatilidade)", minval=1, group=grp_engine)

grp_trail   = "Trailing Stop Catraca & Alvos"
mult_stop   = input.float(1.8, "Multiplicador Trailing Stop (Laranja)", minval=0.1, step=0.1, group=grp_trail)
mult_tp1    = input.float(2.2, "Multiplicador TP 1 (Verde)", minval=0.5, step=0.1, group=grp_trail)
mult_tp2    = input.float(3.4, "Multiplicador TP 2 (Azul)", minval=0.5, step=0.1, group=grp_trail)
mult_tp3    = input.float(4.8, "Multiplicador TP 3 (Rosa)", minval=0.5, step=0.1, group=grp_trail)

grp_vis     = "Visualização no Gráfico"
show_medias = input.bool(true, "Exibir Médias ZLEMA e KAMA", group=grp_vis)
show_labels = input.bool(true, "Exibir Badges de Entrada / Stop", group=grp_vis)

// =============================================================================
// 2. MOTORES MATEMÁTICOS SUAVIZADOS
// =============================================================================
atr_val = ta.atr(len_atr)
histerese = atr_val * hist_mult

// 2.1 ZLEMA Suavizada (Compensação de atraso com amortecimento duplo)
lag_z   = math.floor((fast_len - 1) / 2)
z_data  = close + (close - close[lag_z])
zlema_raw = ta.ema(z_data, fast_len)
// Filtro adicional de 3 períodos para eliminar ruídos de velas de 15m/5m
zlema   = ta.ema(zlema_raw, 3)

// 2.2 KAMA Adaptativa
kama_mom = math.abs(close - close[kama_len])
kama_vol = math.sum(math.abs(close - close[1]), kama_len)
kama_er  = kama_vol == 0 ? 0.0 : kama_mom / kama_vol
fast_sc  = 2.0 / (2.0 + 1.0)
slow_sc  = 2.0 / (30.0 + 1.0)
kama_sc  = math.pow(kama_er * (fast_sc - slow_sc) + slow_sc, 2)

var float kama = na
kama := na(kama[1]) ? close : kama[1] + kama_sc * (close - kama[1])

// =============================================================================
// 3. REGIME COM BARREIRA DE HISTERESE (ANTI-METRALHADORA)
// =============================================================================
var int regime = 0
// Só altera o regime se romper a barreira de volatilidade (Histerese)
if zlema > (kama + histerese)
    regime := 1   // Bull
else if zlema < (kama - histerese)
    regime := -1  // Bear

cross_bull = (regime == 1 and regime[1] != 1)
cross_bear = (regime == -1 and regime[1] != -1)

// =============================================================================
// 4. TRAILING STOP CATRACA & ALVOS ESTÁVEIS
// =============================================================================
var int   trade_dir  = 0     // 1: Long, -1: Short, 0: Fora
var float stop_val   = na
var float tp1_val    = na
var float tp2_val    = na
var float tp3_val    = na

// Bloqueio para evitar reabertura imediata na mesma consolidação
var bool lock_reentry_l = false
var bool lock_reentry_s = false

if cross_bull
    lock_reentry_s := false
if cross_bear
    lock_reentry_l := false

cand_stop_l = low - (atr_val * mult_stop)
cand_stop_s = high + (atr_val * mult_stop)

// Gatilhos de Entrada Filtrados (Apenas se o regime confirmar e não houver bloqueio)
trigger_long  = cross_bull or (trade_dir == 0 and regime == 1 and not lock_reentry_l and ta.crossover(close, zlema) and close > open)
trigger_short = cross_bear or (trade_dir == 0 and regime == -1 and not lock_reentry_s and ta.crossunder(close, zlema) and close < open)

// 1. Execução Long
if trigger_long and trade_dir != 1
    trade_dir      := 1
    lock_reentry_s := false
    stop_val       := cand_stop_l
    tp1_val        := close + (atr_val * mult_tp1)
    tp2_val        := close + (atr_val * mult_tp2)
    tp3_val        := close + (atr_val * mult_tp3)
    if show_labels
        label.new(bar_index, low - (atr_val * 0.4), "ENTRADA L", color=#00E676, textcolor=color.black, style=label.style_label_up, size=size.small)

// 2. Execução Short
else if trigger_short and trade_dir != -1
    trade_dir      := -1
    lock_reentry_l := false
    stop_val       := cand_stop_s
    tp1_val        := close - (atr_val * mult_tp1)
    tp2_val        := close - (atr_val * mult_tp2)
    tp3_val        := close - (atr_val * mult_tp3)
    if show_labels
        label.new(bar_index, high + (atr_val * 0.4), "ENTRADA S", color=#F44336, textcolor=color.white, style=label.style_label_down, size=size.small)

// 3. Catraca do Trailing Stop (Avança apenas a favor da tendência com fechamento confirmado)
if trade_dir == 1 and not na(stop_val)
    if close > zlema and cand_stop_l > stop_val
        stop_val := cand_stop_l

else if trade_dir == -1 and not na(stop_val)
    if close < zlema and cand_stop_s < stop_val
        stop_val := cand_stop_s

// 4. Execução do Stop
stop_hit_l = trade_dir == 1 and not na(stop_val) and close < stop_val
stop_hit_s = trade_dir == -1 and not na(stop_val) and close > stop_val

if stop_hit_l
    if show_labels
        label.new(bar_index, high + (atr_val * 0.3), "STOP L", color=#FF9100, textcolor=color.black, style=label.style_label_down, size=size.tiny)
    trade_dir      := 0
    lock_reentry_l := true
    stop_val       := na
    tp1_val        := na
    tp2_val        := na
    tp3_val        := na

if stop_hit_s
    if show_labels
        label.new(bar_index, low - (atr_val * 0.3), "STOP S", color=#FF9100, textcolor=color.black, style=label.style_label_up, size=size.tiny)
    trade_dir      := 0
    lock_reentry_s := true
    stop_val       := na
    tp1_val        := na
    tp2_val        := na
    tp3_val        := na

// =============================================================================
// 5. PLOTAGEM PURA
// =============================================================================
// Médias Guia
plot(show_medias ? zlema : na, "ZLEMA Suavizada", color=#00E5FF, linewidth=2)
plot(show_medias ? kama : na,  "KAMA Base",       color=#FFEB3B, linewidth=2)

// Camadas de Trailing Stop e Alvos (Sem Fragmentação)
plot(stop_val, "Trailing Stop (Laranja)", color=color.orange, linewidth=2, style=plot.style_stepline)
plot(tp1_val,  "TP 1 (Verde)",            color=#00E676,      linewidth=1, style=plot.style_stepline)
plot(tp2_val,  "TP 2 (Azul)",             color=#00B0FF,      linewidth=1, style=plot.style_stepline)
plot(tp3_val,  "TP 3 (Rosa)",             color=#E91E63,      linewidth=2, style=plot.style_stepline)
