alertcondition(fibHit2,      title="[FIB] Hit 2.618",     message="{{strategy.alert_message}}")
alertcondition(fibHit3,      title="[FIB] Hit 3.618",     message="{{strategy.alert_message}}")
alertcondition(fibHit4,      title="[FIB] Hit 4.618",     message="{{strategy.alert_message}}")
alertcondition(fibHit5,      title="[FIB] Hit 5.618",     message="{{strategy.alert_message}}")
