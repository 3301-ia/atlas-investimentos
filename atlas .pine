alertcondition(goldSell,  title="[SELL] GOLD",   message="{{strategy.alert_message}}")
alertcondition(h1BuyFin,  title="[BUY] H1RSI",   message="{{strategy.alert_message}}")
alertcondition(h1SellFin, title="[SELL] H1RSI",  message="{{strategy.alert_message}}")
alertcondition(stBuy,     title="[BUY] STRESS",  message="{{strategy.alert_message}}")
alertcondition(stSell,    title="[SELL] STRESS", message="{{strategy.alert_message}}")

// Alertas Fibonacci
if fibNewAnchor
    alert(f_fibJson(fibBull ? "BULL" : "BEAR"), alert.freq_once_per_bar)
if fibHit1
    alert(f_hitJson("1.618", fibBull ? high : low), alert.freq_once_per_bar)
if fibHit2
    alert(f_hitJson("2.618", fibBull ? high : low), alert.freq_once_per_bar)
if fibHit3
    alert(f_hitJson("3.618", fibBull ? high : low), alert.freq_once_per_bar)
if fibHit4
    alert(f_hitJson("4.618", fibBull ? high : low), alert.freq_once_per_bar)
if fibHit5
    alert(f_hitJson("5.618", fibBull ? high : low), alert.freq_once_per_bar)

alertcondition(fibNewAnchor, title="[FIB] Nova ancora",   message="{{strategy.alert_message}}")
